# ReviewForge Environment Configuration (.env.example)

# Local Ollama Provider (Default)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Optional Google Gemini Provider (Leave blank for 100% local operation)
GEMINI_API_KEY=

# Custom Storage Paths (Optional)
REVIEWS_DB_PATH=data/reviews.db
REVIEWS_LOG_DIR=logs
